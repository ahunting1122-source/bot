# Copy to backend/.env. Runtime data is excluded from Git.
ORBIT_MODEL=
# Provider id from `app/providers.py` (deepseek / openai / anthropic / gemini / ...).
# Empty = resolve it from ORBIT_MODEL_BASE_URL; `orbit model <provider>` writes the
# runtime override into data/settings.json instead of this file.
# ORBIT_MODEL_PROVIDER=
ORBIT_MODEL_BASE_URL=https://api.openai.com/v1
# Never put a real key here: `orbit login --provider <id>` stores it in the system
# keyring (service = orbit:<data_dir>). This line only documents the variable name.
ORBIT_MODEL_API_KEY=
ORBIT_GITHUB_TOKEN=
ORBIT_GITHUB_REPO=
ORBIT_NOTION_URL=
# Default workspace: ../data/workspace
# ORBIT_WORKSPACE=E:/your-authorized-folder
